# Normalize text files in the repository.
* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows launchers remain CRLF for cmd.exe compatibility.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.apk binary
*.jks binary
*.keystore binary
*.zip binary
*.gz binary
