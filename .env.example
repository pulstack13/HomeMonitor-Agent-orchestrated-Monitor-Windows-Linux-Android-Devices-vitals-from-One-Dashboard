# HomeMonitor environment variables (example)
#
# This file is documentation, not a dotenv file that is loaded automatically.
# Copy the values you need into your shell, a systemd EnvironmentFile, or the
# Windows service launcher. Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Central server
# ---------------------------------------------------------------------------
# Directory containing homemonitor.db, config.json, pairing_code.txt and logs.
HOMEMONITOR_DATA_DIR=./data

# HTTP bind address. 0.0.0.0 allows agents and browsers on the LAN to connect.
HOMEMONITOR_HOST=0.0.0.0

# HTTP port. Remember to allow it in the host firewall on private networks.
HOMEMONITOR_PORT=8787

# UDP discovery responder (1 enabled, 0 disabled). Discovery uses UDP 45892.
HOMEMONITOR_DISCOVERY=1

# Leave empty to generate a random 256-bit token and save it in config.json.
# Set a long random value only when you need to inject the token yourself.
HOMEMONITOR_ADMIN_TOKEN=

# Optional fixed pairing code. Leave empty to generate and persist one.
HOMEMONITOR_PAIRING_CODE=

# Override the dashboard directory for custom packaging.
# HOMEMONITOR_DASHBOARD_DIR=./dashboard

# ---------------------------------------------------------------------------
# Desktop agent
# ---------------------------------------------------------------------------
# Path to agent.json. Windows default: %APPDATA%\HomeMonitor\agent.json
# Linux default: ~/.config/homemonitor/agent.json
# HOMEMONITOR_CONFIG=

# Controller URL. Use the controller's LAN address, not a public hostname.
HOMEMONITOR_CONTROLLER=http://192.0.2.10:8787

# Friendly name shown in the dashboard. Defaults to the hostname.
HOMEMONITOR_NAME=

# One-time pairing code. Prefer the installer flag so it is not left in a file.
HOMEMONITOR_PAIRING_CODE=
