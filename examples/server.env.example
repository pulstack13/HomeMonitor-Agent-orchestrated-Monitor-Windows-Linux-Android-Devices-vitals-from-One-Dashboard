# HomeMonitor controller environment (Linux systemd example)
#
# Install path: /etc/homemonitor/server.env
# Permissions: root:homemonitor 0640 is a reasonable starting point.
# Do not commit a filled-in copy.

HOMEMONITOR_DATA_DIR=/var/lib/homemonitor
HOMEMONITOR_HOST=0.0.0.0
HOMEMONITOR_PORT=8787
HOMEMONITOR_DISCOVERY=1

# Leave empty to generate and persist a token in config.json.
HOMEMONITOR_ADMIN_TOKEN=

# Leave empty to generate and persist a pairing code.
HOMEMONITOR_PAIRING_CODE=
